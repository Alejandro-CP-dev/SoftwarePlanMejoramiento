                string consulta = @"
                                    SELECT
                                        p.Id,
                                        p.Codigo,
                                        p.Nombre,
                                        p.Version,
                                        p.Duracion,
                                        p.Estado,

                                        nf.Nombre AS NivelFormacion

                                    FROM Programa p
                                    INNER JOIN NivelFormacion nf
                                        ON p.IdNivel = nf.Id";
                SqlCommand cmd = new SqlCommand(consulta, conn);
                SqlDataReader dr = cmd.ExecuteReader();

