<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="PlanMejoramientoWeb.Vista.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Plan de Mejoramiento SENA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f4f4f0;
            display: flex;
            min-height: 100vh;
        }

        #form1 {
            display: flex;
            flex-direction: row;
            min-height: 100vh;
            width: 100%;
        }

        .gv-wrapper,
        .gv-programas {
            width: 100% !important;
        }

        .card {
            width: 100%;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 230px;
            min-width: 230px;
            min-height: 100vh;
            background: #0F6E56;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .sb-brand {
            padding: 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sb-brand-icon {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.15);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .sb-brand-icon svg {
                width: 20px;
                height: 20px;
                fill: none;
                stroke: #fff;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .sb-brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 15px;
            color: #fff;
            display: block;
            line-height: 1.2;
        }

        .sb-brand-sub {
            font-size: 10px;
            color: rgba(255,255,255,0.55);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: block;
        }

        .sb-section {
            padding: 1rem 0.75rem 0.5rem;
        }

        .sb-section-label {
            font-size: 10px;
            color: rgba(255,255,255,0.4);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 0.5rem;
            margin-bottom: 6px;
            display: block;
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 8px;
            color: rgba(255,255,255,0.72);
            font-size: 13px;
            text-decoration: none;
            transition: background 0.12s;
            margin-bottom: 2px;
        }

            .sb-link:hover {
                background: rgba(255,255,255,0.12);
                color: #fff;
            }

            .sb-link.active {
                background: rgba(255,255,255,0.18);
                color: #fff;
                font-weight: 500;
            }

            .sb-link i {
                font-size: 16px;
            }

        .sb-bottom {
            margin-top: auto;
            padding: 1rem 0.75rem;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .sb-user {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .sb-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 500;
            color: #fff;
            flex-shrink: 0;
        }

        .sb-user-name {
            font-size: 12px;
            color: #fff;
            font-weight: 500;
            display: block;
        }

        .sb-user-role {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            display: block;
        }

        .sb-logout {
            margin-left: auto;
            font-size: 16px;
            color: rgba(255,255,255,0.45);
            cursor: pointer;
            text-decoration: none;
        }

            .sb-logout:hover {
                color: #fff;
            }

        /* ── Main area ── */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .topbar {
            height: 54px;
            background: #fff;
            border-bottom: 1px solid #e5e5e0;
            display: flex;
            align-items: center;
            padding: 0 1.75rem;
            gap: 12px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .topbar-title {
            font-size: 15px;
            font-weight: 500;
            color: #1a1a1a;
            flex: 1;
        }

        .topbar-user {
            font-size: 13px;
            color: #555;
        }

        .topbar-role {
            font-size: 11px;
            background: #E1F5EE;
            color: #0F6E56;
            border-radius: 20px;
            padding: 3px 10px;
            font-weight: 500;
        }

        .topbar-icon {
            font-size: 19px;
            color: #888;
            cursor: pointer;
        }

        .page-content {
            width: 100%;
            max-width: 100%;
            padding: 2rem 1.75rem;
            flex: 1;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="sidebar">
            <div class="sb-brand">
                <div class="sb-brand-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2L2 7l10 5 10-5-10-5z" />
                        <path d="M2 17l10 5 10-5" />
                        <path d="M2 12l10 5 10-5" />
                    </svg>
                </div>
                <div>
                    <span class="sb-brand-name">PlanMejoramiento</span>
                    <span class="sb-brand-sub">SENA</span>
                </div>
            </div>

            <%-- Menú Administrador --%>
            <asp:Panel ID="pnlAdministrador" runat="server" CssClass="sb-section">
                <span class="sb-section-label">Administrador</span>
                <a href="Inicio.aspx" class="sb-link"><i class="ti ti-home"></i>Inicio</a>
                <a href="Programas.aspx" class="sb-link"><i class="ti ti-books"></i>Programas</a>
                <a href="Ficha.aspx" class="sb-link"><i class="ti ti-id-badge"></i>Fichas</a>
                <a href="Instructores.aspx" class="sb-link"><i class="ti ti-users"></i>Instructores</a>
                <a href="Aprendices.aspx" class="sb-link"><i class="ti ti-school"></i>Aprendices</a>
            </asp:Panel>

            <%-- Menú Instructor --%>
            <asp:Panel ID="pnlInstructor" runat="server" CssClass="sb-section">
                <span class="sb-section-label">Instructor</span>
                <a href="/Instructor/Inicio.aspx" class="sb-link"><i class="ti ti-home"></i>Inicio</a>
                <a href="/Instructor/Planes.aspx" class="sb-link"><i class="ti ti-clipboard-list"></i>Planes</a>
                <a href="/Instructor/Evaluaciones.aspx" class="sb-link"><i class="ti ti-checklist"></i>Evaluaciones</a>
            </asp:Panel>

            <%-- Menú Aprendiz --%>
            <asp:Panel ID="pnlAprendiz" runat="server" CssClass="sb-section">
                <span class="sb-section-label">Aprendiz</span>
                <a href="/Aprendiz/Inicio.aspx" class="sb-link"><i class="ti ti-home"></i>Inicio</a>
                <a href="/Aprendiz/MisPlanes.aspx" class="sb-link"><i class="ti ti-clipboard-list"></i>Mis Planes</a>
                <a href="/Aprendiz/Evidencias.aspx" class="sb-link"><i class="ti ti-file-upload"></i>Evidencias</a>
            </asp:Panel>

            <div class="sb-bottom">
                <div class="sb-user">
                    <div class="sb-avatar">
                        <asp:Label ID="lblIniciales" runat="server" Text=""></asp:Label>
                    </div>
                    <div>
                        <asp:Label ID="lblUsuario" runat="server" CssClass="sb-user-name"></asp:Label>
                        <asp:Label ID="lblRol" runat="server" CssClass="sb-user-role"></asp:Label>
                    </div>
                    <asp:LinkButton ID="btnCerrarSesion" runat="server"
                        OnClick="btnCerrarSesion_Click"
                        CssClass="sb-logout"
                        title="Cerrar sesión">
                    <i class="ti ti-logout"></i>
                    </asp:LinkButton>
                </div>
            </div>
        </div>

        <div class="main-wrapper">
            <div class="topbar">
                <span class="topbar-title">Plan de Mejoramiento SENA</span>
                <span class="topbar-role">
                    <asp:Label ID="lblRolTopbar" runat="server"></asp:Label>
                </span>
            </div>

            <div class="page-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
</body>
</html>
